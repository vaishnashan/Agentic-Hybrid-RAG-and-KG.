# API service — FastAPI backend.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copies utils/ (agent4, api7, retrieval2, ingestion1, knowledge_graph3,
# observability5) AND data/processed/bm25_index.pkl — sparse_retriever.py reads
# that pickle file directly from disk at query time, so it must ship inside
# the image, not just the code. See .dockerignore — it deliberately does NOT
# exclude data/processed.
COPY . .

# Run as non-root — no reason this process needs root inside the container.
RUN useradd --create-home appuser
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "utils.api7.main:app", "--host", "0.0.0.0", "--port", "8000"]